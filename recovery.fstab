/           ext4     /dev/block/bootdevice/by-name/system       flags=display=System;slotselect
/vendor     ext4     /dev/block/bootdevice/by-name/vendor       flags=display=Vendor;slotselect
/data       ext4     /dev/block/bootdevice/by-name/userdata     flags=display=Data;forceencrypt=footer
/sdcard     vfat     /dev/block/mmcblk1p1                       flags=display=MicroSD;storage
/boot       emmc     /dev/block/bootdevice/by-name/boot         flags=display=Boot;slotselect
/misc       emmc     /dev/block/bootdevice/by-name/misc         flags=display=Misc
/firmware  ext4     /dev/block/bootdevice/by-name/modem        flags=display=Firmware;slotselect
/dsp       ext4     /dev/block/bootdevice/by-name/dsp         flags=display=DSP;slotselect
/bluetooth emmc     /dev/block/bootdevice/by-name/bluetooth    flags=display=Bluetooth;backup=1
/persist   ext4     /dev/block/bootdevice/by-name/persist     flags=display=Persist;backup=1
/usbotg    auto     /dev/block/sda1                             flags=display=USB-OTG;storage;removable
